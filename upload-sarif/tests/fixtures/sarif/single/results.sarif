{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ActTestTool",
          "version": "1.0.0",
          "informationUri": "https://example.com/act-test-tool",
          "rules": [
            {
              "id": "ACT001",
              "name": "ActTestRule",
              "shortDescription": { "text": "Act test rule" },
              "fullDescription": { "text": "A rule used for testing SARIF upload." },
              "defaultConfiguration": { "level": "warning" }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "ACT001",
          "ruleIndex": 0,
          "level": "warning",
          "message": { "text": "Test finding" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "tests/fixtures/sarif/single/results.sarif" },
                "region": { "startLine": 1 }
              }
            }
          ],
          "partialFingerprints": {
            "primaryLocationLineHash": "0123456789abcdef:1"
          }
        }
      ]
    }
  ]
}
