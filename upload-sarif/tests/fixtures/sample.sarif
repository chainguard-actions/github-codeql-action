{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ActTestTool",
          "version": "1.0.0",
          "semanticVersion": "1.0.0",
          "rules": [
            {
              "id": "TEST001",
              "name": "TestRule",
              "shortDescription": { "text": "Test rule" },
              "fullDescription": { "text": "A test rule used by act tests." },
              "defaultConfiguration": { "level": "warning" },
              "properties": { "tags": ["test"] }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "TEST001",
          "ruleIndex": 0,
          "level": "warning",
          "message": { "text": "Test finding" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "README.md" },
                "region": { "startLine": 1 }
              }
            }
          ],
          "partialFingerprints": { "primaryLocationLineHash": "abc123:1" }
        }
      ]
    }
  ]
}
