{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ActTestToolA",
          "semanticVersion": "1.0.0",
          "rules": [
            { "id": "A001", "shortDescription": { "text": "Rule A" } }
          ]
        }
      },
      "results": [
        {
          "ruleId": "A001",
          "message": { "text": "Finding A" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "README.md" },
                "region": { "startLine": 1 }
              }
            }
          ]
        }
      ]
    }
  ]
}
